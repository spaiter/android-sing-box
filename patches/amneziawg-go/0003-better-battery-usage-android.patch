diff --git a/device/worker_count.go b/device/worker_count.go
new file mode 100644
index 0000000..e41f15f
--- /dev/null
+++ b/device/worker_count.go
@@ -0,0 +1,13 @@
+package device
+
+import "runtime"
+
+const maxAndroidWorkers = 4
+
+func workerCount() int {
+	cpus := runtime.NumCPU()
+	if runtime.GOOS == "android" && cpus > maxAndroidWorkers {
+		return maxAndroidWorkers
+	}
+	return cpus
+}
