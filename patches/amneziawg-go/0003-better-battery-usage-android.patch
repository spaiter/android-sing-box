+++ b/device/magic_header_test.go
@@ -0,0 +1,28 @@
+package device
+
+import "testing"
+
+func TestMagicHeaderGenerateFixedValue(t *testing.T) {
+	header := &magicHeader{start: 4, end: 4}
+
+	for range 100 {
+		if value := header.Generate(); value != 4 {
+			t.Fatalf("value = %d", value)
+		}
+		if value := header.GenerateFast(newFastRandom()); value != 4 {
+			t.Fatalf("fast value = %d", value)
+		}
+	}
+}
+
+func TestMagicHeaderGenerateFastRange(t *testing.T) {
+	header := &magicHeader{start: 10, end: 20}
+	random := newFastRandom()
+
+	for range 1000 {
+		value := header.GenerateFast(random)
+		if value < 10 || value > 20 {
+			t.Fatalf("value out of range: %d", value)
+		}
+	}
+}
