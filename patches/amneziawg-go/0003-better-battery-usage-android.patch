diff --git a/device/fast_random.go b/device/fast_random.go
new file mode 100644
index 0000000..c1ae059
--- /dev/null
+++ b/device/fast_random.go
@@ -0,0 +1,47 @@
+package device
+
+import (
+	cryptorand "crypto/rand"
+	"encoding/binary"
+	randv2 "math/rand/v2"
+	"os"
+	"sync"
+	"time"
+)
+
+type fastRandom struct {
+	access sync.Mutex
+	source *randv2.ChaCha8
+}
+
+func newFastRandom() *fastRandom {
+	var seed [32]byte
+	if _, err := cryptorand.Read(seed[:]); err != nil {
+		binary.LittleEndian.PutUint64(seed[0:8], uint64(time.Now().UnixNano()))
+		binary.LittleEndian.PutUint64(seed[8:16], uint64(os.Getpid()))
+	}
+	return &fastRandom{
+		source: randv2.NewChaCha8(seed),
+	}
+}
+
+func (r *fastRandom) Read(p []byte) {
+	r.access.Lock()
+	_, _ = r.source.Read(p)
+	r.access.Unlock()
+}
+
+func (r *fastRandom) Uint64N(n uint64) uint64 {
+	if n <= 1 {
+		return 0
+	}
+	limit := ^uint64(0) - (^uint64(0) % n)
+	r.access.Lock()
+	defer r.access.Unlock()
+	for {
+		value := r.source.Uint64()
+		if value < limit {
+			return value % n
+		}
+	}
+}
diff --git a/device/fast_random_test.go b/device/fast_random_test.go
new file mode 100644
index 0000000..4439b1d
--- /dev/null
+++ b/device/fast_random_test.go
@@ -0,0 +1,27 @@
+package device
+
+import (
+	"bytes"
+	"testing"
+)
+
+func TestFastRandomReadFillsBuffer(t *testing.T) {
+	random := newFastRandom()
+	buffer := make([]byte, 64)
+
+	random.Read(buffer)
+
+	if bytes.Equal(buffer, make([]byte, len(buffer))) {
+		t.Fatal("buffer was not filled")
+	}
+}
+
+func TestFastRandomUint64NBounds(t *testing.T) {
+	random := newFastRandom()
+
+	for range 1000 {
+		if value := random.Uint64N(7); value >= 7 {
+			t.Fatalf("value out of range: %d", value)
+		}
+	}
+}
diff --git a/device/magic-header.go b/device/magic-header.go
index 78e59d6..5096e8a 100644
--- a/device/magic-header.go
+++ b/device/magic-header.go
@@ -57,7 +57,18 @@ func (h *magicHeader) Validate(val uint32) bool {
 }
 
 func (h *magicHeader) Generate() uint32 {
+	if h.start == h.end {
+		return h.start
+	}
 	high := int64(h.end - h.start + 1)
 	r, _ := rand.Int(rand.Reader, big.NewInt(high))
 	return h.start + uint32(r.Int64())
 }
+
+func (h *magicHeader) GenerateFast(random *fastRandom) uint32 {
+	if h.start == h.end {
+		return h.start
+	}
+	span := uint64(h.end) - uint64(h.start) + 1
+	return h.start + uint32(random.Uint64N(span))
+}
diff --git a/device/magic_header_test.go b/device/magic_header_test.go
new file mode 100644
